{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.lz4/lz4-java {:mvn/version "1.8.0"}
        com.github.luben/zstd-jni {:mvn/version "1.5.7-2"}
        org.tukaani/xz {:mvn/version "1.10"}
        com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}
        com.github.mwiede/jsch {:mvn/version "0.2.18"}
        com.formdev/flatlaf {:mvn/version "3.7.2"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :uber {:extra-deps {com.github.seancorfield/depstar {:mvn/version "2.1.303"}}
         :exec-fn hf.depstar/uberjar
         :exec-args {:jar "target/borgi.jar" :aot true :main-class borgclj.main}}}}
